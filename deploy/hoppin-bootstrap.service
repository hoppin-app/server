# systemd unit for the hoppin bootstrap server.
#
# Install:
#   sudo useradd --system --home /opt/hoppin --shell /usr/sbin/nologin hoppin
#   sudo mkdir -p /opt/hoppin /var/lib/hoppin
#   sudo chown -R hoppin:hoppin /opt/hoppin /var/lib/hoppin
#   sudo chmod 700 /var/lib/hoppin
#   # copy bootstrap.py + requirements.txt to /opt/hoppin, create the venv:
#   sudo -u hoppin python3 -m venv /opt/hoppin/venv
#   sudo -u hoppin /opt/hoppin/venv/bin/pip install -r /opt/hoppin/requirements.txt
#   sudo cp server/hoppin-bootstrap.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now hoppin-bootstrap
#
# Secrets (TWILIO_AUTH_TOKEN etc.) go in /etc/hoppin/bootstrap.env, mode 600,
# owned by root, NOT in this unit file.

[Unit]
Description=hoppin bootstrap server (certificate authority + encrypted relay)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hoppin
Group=hoppin
WorkingDirectory=/var/lib/hoppin

Environment=HOPPIN_ENV=prod
Environment=HOPPIN_TLS_PORT=4443
Environment=HOPPIN_TLS_CERT=/etc/hoppin/tls/cert.pem
Environment=HOPPIN_TLS_KEY=/etc/hoppin/tls/key.pem
Environment=HOPPIN_IDENTITY_KEY=/var/lib/hoppin/bootstrap_identity.key
Environment=HOPPIN_STATE=/var/lib/hoppin/bootstrap_state.json
Environment=HOPPIN_REPORTS=/var/lib/hoppin/reports.jsonl
# TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_FROM live here:
EnvironmentFile=/etc/hoppin/bootstrap.env

ExecStart=/opt/hoppin/venv/bin/python /opt/hoppin/bootstrap.py

# SIGTERM makes the server flush its state file before exiting.
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=5

# Binding 4443 needs no privilege, but keep this if you move to 443.
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Hardening
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
ReadWritePaths=/var/lib/hoppin
ReadOnlyPaths=/etc/hoppin
UMask=0077

[Install]
WantedBy=multi-user.target
